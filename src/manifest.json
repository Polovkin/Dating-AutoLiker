{
  "{{chrome}}.manifest_version": 3,
  "{{firefox}}.manifest_version": 2,

  "name": "AutoLiker",
  "description": "Автоматично лайкає анкети на Tinder та Badoo",
  "version": "1.0.0",

  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },

  "{{chrome}}.action": {
    "default_popup": "src/popup.html"
  },
  "{{firefox}}.browser_action": {
    "default_popup": "src/popup.html"
  },

  "background": {
    "{{chrome}}.service_worker": "src/background.ts",
    "{{firefox}}.scripts": ["src/background.ts"]
  },

  "permissions": [
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://tinder.com/*",
    "https://badoo.com/*"
  ]
}
